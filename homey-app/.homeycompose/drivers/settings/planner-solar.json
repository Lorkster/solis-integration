      "label": {
        "en": "Array 1 size",
        "sv": "Yta 1 storlek"
      },
      "value": 11,
      "min": 0,
      "max": 100,
      "step": 0.1,
      "units": {
        "en": "kWp"
      },
      "hint": {
        "en": "Also used with Solcast, to judge when production is high enough to learn from.",
        "sv": "Används även med Solcast, för att avgöra när produktionen är hög nog att lära av."
