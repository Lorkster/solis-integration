{
  "type": "group",
  "label": {
    "en": "Power fee (effektavgift)",
    "sv": "Effektavgift"
  },
  "children": [
    {
      "id": "power_tariff_enabled",
      "type": "checkbox",
      "label": {
        "en": "My grid fee includes a power fee",
        "sv": "Mitt nätavtal har effektavgift"
      },
      "value": false,
      "hint": {
        "en": "The grid company charges per kW of the month's highest import peaks. The plan then avoids new peaks, and grid charging stays below the month's peak level.",
        "sv": "Nätbolaget tar betalt per kW för månadens högsta effekttoppar. Planen undviker då nya toppar, och nätladdning håller sig under månadens toppnivå."
      }
    },
    {
      "id": "power_tariff_price",
      "type": "number",
      "label": {
        "en": "Price per kW and month (incl. VAT)",
        "sv": "Pris per kW och månad (inkl. moms)"
      },
      "value": 0,
      "min": 0,
      "max": 1000,
      "step": 0.01,
      "units": {
        "en": "per kW",
        "sv": "per kW"
      }
    },
    {
      "id": "power_tariff_peaks",
      "type": "number",
      "label": {
        "en": "Number of peaks averaged",
        "sv": "Antal toppar i medelvärdet"
      },
      "value": 3,
      "min": 1,
      "max": 10,
      "step": 1
    },
    {
      "id": "power_tariff_distinct_days",
