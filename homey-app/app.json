{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.lorkster.solisbattery",
  "version": "0.1.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Solis Smart Battery",
    "sv": "Solis Smart Batteri"
  },
  "description": {
    "en": "Charge your Solis battery when electricity is cheap, keep a reserve for power outages",
    "sv": "Ladda Solis-batteriet när elen är billig och behåll en reserv för strömavbrott"
  },
  "category": [
    "energy"
  ],
  "permissions": [
    "homey:manager:geolocation"
  ],
  "brandColor": "#E8751A",
  "author": {
    "name": "Lorkster"
  },
  "source": "https://github.com/Lorkster/solis-integration",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "esm": true,
  "flow": {
    "triggers": [
      {
        "id": "plan_updated",
        "title": {
          "en": "The battery plan was updated",
          "sv": "Batteriplanen uppdaterades"
        },
        "tokens": [
          {
            "name": "summary",
            "type": "string",
            "title": {
              "en": "Summary"
            },
            "example": {
              "en": "Charge 02:00–04:30"
            }
          },
          {
            "name": "savings",
            "type": "number",
            "title": {
              "en": "Expected savings (SEK)"
            },
            "example": 12.5
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=solis-inverter"
          }
        ]
      },
      {
        "id": "action_changed",
        "title": {
          "en": "The planned battery action changed",
          "sv": "Planerad batteriåtgärd ändrades"
        },
        "tokens": [
          {
            "name": "action",
            "type": "string",
            "title": {
              "en": "Action"
            },
            "example": {
              "en": "charge"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=solis-inverter"
          }
        ]
      },
      {
        "id": "weather_warning_started",
        "title": {
          "en": "An SMHI warning was issued for my location",
          "sv": "En SMHI-varning utfärdades för min plats"
        },
        "tokens": [
          {
            "name": "level",
            "type": "string",
            "title": {
              "en": "Level",
              "sv": "Nivå"
            },
            "example": "YELLOW"
          },
          {
            "name": "title",
            "type": "string",
            "title": {
              "en": "Warning",
              "sv": "Varning"
            },
            "example": {
              "en": "Strong wind",
              "sv": "Mycket hårda vindbyar"
            }
          },
          {
            "name": "area",
            "type": "string",
            "title": {
              "en": "Area",
              "sv": "Område"
            },
            "example": "Uppsala län"
          },
          {
            "name": "until",
            "type": "string",
            "title": {
              "en": "Until",
              "sv": "Till"
            },
            "example": "18:00"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=solis-inverter"
          }
        ]
      },
      {
        "id": "weather_warning_ended",
        "title": {
          "en": "The SMHI warnings for my location ended",
          "sv": "SMHI-varningarna för min plats upphörde"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=solis-inverter"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "planned_action_is",
        "title": {
          "en": "Planned action !{{is|is not}}",
          "sv": "Planerad åtgärd !{{är|är inte}}"
        },
        "titleFormatted": {
          "en": "Planned action !{{is|is not}} [[action]]",
          "sv": "Planerad åtgärd !{{är|är inte}} [[action]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=solis-inverter"
          },
          {
            "type": "dropdown",
            "name": "action",
            "values": [
              {
                "id": "charge",
                "title": {
                  "en": "charging from grid",
                  "sv": "laddning från nätet"
                }
              },
              {
                "id": "hold",
                "title": {
                  "en": "holding charge",
                  "sv": "spara laddningen"
                }
              },
              {
                "id": "self_use",
                "title": {
                  "en": "self-use",
                  "sv": "egenanvändning"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "price_among_cheapest",
        "title": {
          "en": "Price !{{is|is not}} among the cheapest hours today",
          "sv": "Priset !{{är|är inte}} bland dagens billigaste timmar"
        },
        "titleFormatted": {
          "en": "Price !{{is|is not}} among the [[hours]] cheapest hours today",
          "sv": "Priset !{{är|är inte}} bland dagens [[hours]] billigaste timmar"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=solis-inverter"
          },
          {
            "type": "number",
            "name": "hours",
            "min": 1,
            "max": 24,
            "step": 0.25,
            "placeholder": {
              "en": "4"
            }
          }
        ]
      },
      {
        "id": "weather_warning_active",
        "title": {
          "en": "An SMHI warning !{{is|is not}} active",
          "sv": "En SMHI-varning !{{är|är inte}} aktiv"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=solis-inverter"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "set_control_mode",
        "title": {
          "en": "Set control mode",
          "sv": "Ändra styrläge"
        },
        "titleFormatted": {
          "en": "Set control mode to [[mode]]",
          "sv": "Ändra styrläge till [[mode]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=solis-inverter"
          },
          {
            "type": "dropdown",
            "name": "mode",
            "values": [
              {
                "id": "monitor",
                "title": {
                  "en": "Monitor only",
                  "sv": "Endast övervaka"
                }
              },
              {
                "id": "auto",
                "title": {
                  "en": "Automatic",
                  "sv": "Automatisk"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "force_charge",
        "title": {
          "en": "Charge from grid",
          "sv": "Ladda från nätet"
        },
        "titleFormatted": {
          "en": "Charge from grid for [[minutes]] minutes",
          "sv": "Ladda från nätet i [[minutes]] minuter"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=solis-inverter"
          },
          {
            "type": "number",
            "name": "minutes",
            "min": 15,
            "max": 1440,
            "step": 15,
            "placeholder": {
              "en": "60"
            }
          }
        ]
      },
      {
        "id": "hold_battery",
        "title": {
          "en": "Save the battery charge",
          "sv": "Spara batteriladdningen"
        },
        "titleFormatted": {
          "en": "Save the battery charge for [[minutes]] minutes",
          "sv": "Spara batteriladdningen i [[minutes]] minuter"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=solis-inverter"
          },
          {
            "type": "number",
            "name": "minutes",
            "min": 15,
            "max": 1440,
            "step": 15,
            "placeholder": {
              "en": "60"
            }
          }
        ]
      },
      {
        "id": "prepare_outage",
        "title": {
          "en": "Prepare for a power outage",
          "sv": "Förbered för strömavbrott"
        },
        "titleFormatted": {
          "en": "Prepare for a power outage during [[hours]] hours",
          "sv": "Förbered för strömavbrott under [[hours]] timmar"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=solis-inverter"
          },
          {
            "type": "number",
            "name": "hours",
            "min": 1,
            "max": 168,
            "step": 1,
            "placeholder": {
              "en": "24"
            }
          }
        ]
      },
      {
        "id": "clear_overrides",
        "title": {
          "en": "Cancel manual battery overrides",
          "sv": "Avbryt manuella batteriåtgärder"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=solis-inverter"
          }
        ]
      },
      {
        "id": "replan_now",
        "title": {
          "en": "Update the battery plan now",
          "sv": "Uppdatera batteriplanen nu"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=solis-inverter"
          }
        ]
      },
      {
        "id": "restore_inverter",
        "title": {
          "en": "Hand control back to the inverter",
          "sv": "Lämna tillbaka styrningen till växelriktaren"
        },
        "hint": {
          "en": "Removes the app's schedule from the inverter and switches to Monitor only.",
          "sv": "Tar bort appens schema från växelriktaren och byter till Endast övervaka."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=solis-inverter"
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Solis hybrid inverter",
        "sv": "Solis hybridväxelriktare"
      },
      "class": "battery",
      "capabilities": [
        "measure_battery",
        "measure_power",
        "solis_control_mode",
        "solis_plan_status",
        "measure_solis_price",
        "measure_solis_pv",
        "measure_solis_load",
        "measure_solis_grid",
        "measure_solis_pv_forecast",
        "measure_solis_reserve",
        "measure_solis_backup_hours",
        "alarm_solis_weather",
        "solis_warning",
        "meter_power.charged",
        "meter_power.discharged"
      ],
      "capabilitiesOptions": {
        "measure_power": {
          "title": {
            "en": "Battery power",
            "sv": "Batteriets effekt"
          }
        },
        "meter_power.charged": {
          "title": {
            "en": "Energy charged",
            "sv": "Laddad energi"
          }
        },
        "meter_power.discharged": {
          "title": {
            "en": "Energy discharged",
            "sv": "Urladdad energi"
          }
        }
      },
      "energy": {
        "homeBattery": true,
        "meterPowerImportedCapability": "meter_power.charged",
        "meterPowerExportedCapability": "meter_power.discharged"
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud"
      ],
      "images": {
        "small": "/drivers/solis-inverter/assets/images/small.png",
        "large": "/drivers/solis-inverter/assets/images/large.png",
        "xlarge": "/drivers/solis-inverter/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "title": {
              "en": "SolisCloud API key",
              "sv": "SolisCloud API-nyckel"
            },
            "usernameLabel": {
              "en": "Key ID",
              "sv": "Nyckel-ID"
            },
            "usernamePlaceholder": {
              "en": "KeyId from SolisCloud API management"
            },
            "passwordLabel": {
              "en": "Key secret",
              "sv": "Nyckelhemlighet"
            },
            "passwordPlaceholder": {
              "en": "KeySecret"
            }
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "SolisCloud connection",
            "sv": "SolisCloud-anslutning"
          },
          "children": [
            {
              "id": "key_id",
              "type": "text",
              "label": {
                "en": "Key ID"
              },
              "value": ""
            },
            {
              "id": "key_secret",
              "type": "password",
              "label": {
                "en": "Key secret"
              },
              "value": ""
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Backup reserve",
            "sv": "Reservkraft"
          },
          "children": [
            {
              "id": "reserve_summer",
              "type": "number",
              "label": {
                "en": "Reserve April–October"
              },
              "value": 25,
              "min": 0,
              "max": 100,
              "step": 1,
              "units": {
                "en": "%"
              }
            },
            {
              "id": "reserve_winter",
              "type": "number",
              "label": {
                "en": "Reserve November–March"
              },
              "value": 30,
              "min": 0,
              "max": 100,
              "step": 1,
              "units": {
                "en": "%"
              }
            },
            {
              "id": "outage_target",
              "type": "number",
              "label": {
                "en": "Charge level when preparing for an outage"
              },
              "value": 100,
              "min": 30,
              "max": 100,
              "step": 1,
              "units": {
                "en": "%"
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Solar forecast",
            "sv": "Solprognos"
          },
          "children": [
            {
              "id": "pv_forecast_enabled",
              "type": "checkbox",
              "label": {
                "en": "Use solar forecast in the plan",
                "sv": "Använd solprognos i planen"
              },
              "value": true,
              "hint": {
                "en": "Irradiance from Open-Meteo for Homey's location, calibrated against your measured production.",
                "sv": "Solinstrålning från Open-Meteo för Homeys plats, kalibrerad mot din uppmätta produktion."
              }
            },
            {
              "id": "pv_array1_kwp",
              "type": "number",
              "label": {
                "en": "Array 1 size",
                "sv": "Yta 1 storlek"
              },
              "value": 11,
              "min": 0,
              "max": 100,
              "step": 0.1,
              "units": {
                "en": "kWp"
              }
            },
            {
              "id": "pv_array1_tilt",
              "type": "number",
              "label": {
                "en": "Array 1 tilt",
                "sv": "Yta 1 lutning"
              },
              "value": 35,
              "min": 0,
              "max": 90,
              "step": 1,
              "units": {
                "en": "°"
              },
              "hint": {
                "en": "0° = flat, 90° = vertical",
                "sv": "0° = platt, 90° = lodrät"
              }
            },
            {
              "id": "pv_array1_azimuth",
              "type": "dropdown",
              "label": {
                "en": "Array 1 facing",
                "sv": "Yta 1 riktning"
              },
              "value": "0",
              "values": [
                {
                  "id": "0",
                  "label": {
                    "en": "South",
                    "sv": "Söder"
                  }
                },
                {
                  "id": "-45",
                  "label": {
                    "en": "South-east",
                    "sv": "Sydost"
                  }
                },
                {
                  "id": "45",
                  "label": {
                    "en": "South-west",
                    "sv": "Sydväst"
                  }
                },
                {
                  "id": "-90",
                  "label": {
                    "en": "East",
                    "sv": "Öster"
                  }
                },
                {
                  "id": "90",
                  "label": {
                    "en": "West",
                    "sv": "Väster"
                  }
                },
                {
                  "id": "-135",
                  "label": {
                    "en": "North-east",
                    "sv": "Nordost"
                  }
                },
                {
                  "id": "135",
                  "label": {
                    "en": "North-west",
                    "sv": "Nordväst"
                  }
                },
                {
                  "id": "180",
                  "label": {
                    "en": "North",
                    "sv": "Norr"
                  }
                }
              ]
            },
            {
              "id": "pv_array2_kwp",
              "type": "number",
              "label": {
                "en": "Array 2 size (0 = none)",
                "sv": "Yta 2 storlek (0 = ingen)"
              },
              "value": 0,
              "min": 0,
              "max": 100,
              "step": 0.1,
              "units": {
                "en": "kWp"
              }
            },
            {
              "id": "pv_array2_tilt",
              "type": "number",
              "label": {
                "en": "Array 2 tilt",
                "sv": "Yta 2 lutning"
              },
              "value": 35,
              "min": 0,
              "max": 90,
              "step": 1,
              "units": {
                "en": "°"
              }
            },
            {
              "id": "pv_array2_azimuth",
              "type": "dropdown",
              "label": {
                "en": "Array 2 facing",
                "sv": "Yta 2 riktning"
              },
              "value": "-90",
              "values": [
                {
                  "id": "0",
                  "label": {
                    "en": "South",
                    "sv": "Söder"
                  }
                },
                {
                  "id": "-45",
                  "label": {
                    "en": "South-east",
                    "sv": "Sydost"
                  }
                },
                {
                  "id": "45",
                  "label": {
                    "en": "South-west",
                    "sv": "Sydväst"
                  }
                },
                {
                  "id": "-90",
                  "label": {
                    "en": "East",
                    "sv": "Öster"
                  }
                },
                {
                  "id": "90",
                  "label": {
                    "en": "West",
                    "sv": "Väster"
                  }
                },
                {
                  "id": "-135",
                  "label": {
                    "en": "North-east",
                    "sv": "Nordost"
                  }
                },
                {
                  "id": "135",
                  "label": {
                    "en": "North-west",
                    "sv": "Nordväst"
                  }
                },
                {
                  "id": "180",
                  "label": {
                    "en": "North",
                    "sv": "Norr"
                  }
                }
              ]
            },
            {
              "id": "pv_trust",
              "type": "number",
              "label": {
                "en": "Forecast trust",
                "sv": "Tillit till prognosen"
              },
              "value": 80,
              "min": 0,
              "max": 100,
              "step": 5,
              "units": {
                "en": "%"
              },
              "hint": {
                "en": "Share of the forecast the plan counts on. Lower = more grid charging before uncertain days.",
                "sv": "Andel av prognosen som planen räknar med. Lägre = mer nätladdning inför osäkra dagar."
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "SMHI weather warnings",
            "sv": "SMHI-vädervarningar"
          },
          "children": [
            {
              "id": "warnings_enabled",
              "type": "checkbox",
              "label": {
                "en": "Prepare for outages on SMHI warnings",
                "sv": "Förbered för strömavbrott vid SMHI-varningar"
              },
              "value": true,
              "hint": {
                "en": "Charges to the outage level while a warning covers Homey's location.",
                "sv": "Laddar till avbrottsnivån medan en varning gäller Homeys plats."
              }
            },
            {
              "id": "warnings_min_level",
              "type": "dropdown",
              "label": {
                "en": "Lowest warning level",
                "sv": "Lägsta varningsnivå"
              },
              "value": "YELLOW",
              "values": [
                {
                  "id": "YELLOW",
                  "label": {
                    "en": "Yellow",
                    "sv": "Gul"
                  }
                },
                {
                  "id": "ORANGE",
                  "label": {
                    "en": "Orange",
                    "sv": "Orange"
                  }
                },
                {
                  "id": "RED",
                  "label": {
                    "en": "Red",
                    "sv": "Röd"
                  }
                }
              ]
            },
            {
              "id": "warnings_weather_only",
              "type": "checkbox",
              "label": {
                "en": "Weather warnings only (not water levels, fire risk)",
                "sv": "Endast vädervarningar (inte vattennivåer, brandrisk)"
              },
              "value": true
            },
            {
              "id": "warnings_lead_hours",
              "type": "number",
              "label": {
                "en": "Start preparing ahead of a warning",
                "sv": "Börja förbereda före en varning"
              },
              "value": 12,
              "min": 0,
              "max": 48,
              "step": 1,
              "units": {
                "en": "h"
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Battery",
            "sv": "Batteri"
          },
          "children": [
            {
              "id": "capacity_kwh",
              "type": "number",
              "label": {
                "en": "Capacity"
              },
              "value": 21.68,
              "min": 1,
              "max": 200,
              "step": 0.01,
              "units": {
                "en": "kWh"
              }
            },
            {
              "id": "max_charge_kw",
              "type": "number",
              "label": {
                "en": "Grid charge power"
              },
              "hint": {
                "en": "Limited by the inverter's max charge current (16 A ≈ 6.7 kW at 420 V)."
              },
              "value": 6.5,
              "min": 0.5,
              "max": 20,
              "step": 0.1,
              "units": {
                "en": "kW"
              }
            },
            {
              "id": "max_discharge_kw",
              "type": "number",
              "label": {
                "en": "Max discharge power"
              },
              "value": 10,
              "min": 0.5,
              "max": 20,
              "step": 0.1,
              "units": {
                "en": "kW"
              }
            },
            {
              "id": "max_soc",
              "type": "number",
              "label": {
                "en": "Max charge level"
              },
              "value": 100,
