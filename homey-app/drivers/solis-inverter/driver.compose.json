          "id": "cycling_cost",
          "type": "number",
          "label": {
            "en": "Battery wear cost"
          },
          "hint": {
            "en": "Cost per kWh discharged. Qapasity Arctic: 10 years / 8000 cycles; about 240 cycles per year makes age the limit, so wear per cycle is low."
          },
          "value": 0.2,
          "min": 0,
          "max": 5,
          "step": 0.01,
          "units": {
            "en": "SEK/kWh"
