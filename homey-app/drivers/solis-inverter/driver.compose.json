          "label": {
            "en": "Use solar forecast in the plan",
            "sv": "Använd solprognos i planen"
          },
          "value": true,
          "hint": {
            "en": "Irradiance from Open-Meteo for Homey's location, calibrated against your measured production.",
            "sv": "Solinstrålning från Open-Meteo för Homeys plats, kalibrerad mot din uppmätta produktion."
          }
        },
        {
          "id": "pv_array1_kwp",
          "type": "number",
          "label": {
            "en": "Array 1 size",
            "sv": "Yta 1 storlek"
          },
          "value": 11,
          "min": 0,
          "max": 100,
          "step": 0.1,
          "units": {
            "en": "kWp"
