{
  "name": {
    "en": "Solis hybrid inverter",
    "sv": "Solis hybridväxelriktare"
  },
  "class": "battery",
  "capabilities": [
    "measure_battery",
    "measure_power",
    "solis_power_source",
    "measure_solis_power_cost",
    "solis_control_mode",
    "solis_plan_status",
    "measure_solis_price",
    "measure_solis_pv",
    "measure_solis_load",
    "measure_solis_grid",
    "measure_solis_surplus",
    "measure_solis_solar_share",
    "measure_solis_battery_share",
    "measure_solis_grid_share",
    "measure_solis_pv_forecast",
    "measure_solis_reserve",
    "measure_solis_backup_hours",
    "alarm_solis_battery_locked",
    "alarm_solis_weather",
    "solis_warning",
    "meter_power.charged",
    "meter_power.discharged"
  ],
  "capabilitiesOptions": {
    "measure_power": {
      "title": {
        "en": "Battery power (+ charging, − discharging)",
        "sv": "Batteriets effekt (+ laddar, − laddar ur)"
      }
    },
    "meter_power.charged": {
      "title": {
        "en": "Energy charged",
        "sv": "Laddad energi"
      }
    },
    "meter_power.discharged": {
      "title": {
        "en": "Energy discharged",
        "sv": "Urladdad energi"
      }
    }
  },
  "energy": {
    "homeBattery": true,
    "meterPowerImportedCapability": "meter_power.charged",
    "meterPowerExportedCapability": "meter_power.discharged"
  },
  "platforms": [
    "local"
  ],
  "connectivity": [
    "cloud"
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "intro",
      "navigation": {
        "next": "login_credentials"
      }
    },
    {
      "id": "login_credentials",
      "template": "login_credentials",
      "options": {
        "title": {
          "en": "SolisCloud API key",
          "sv": "SolisCloud API-nyckel"
        },
        "usernameLabel": {
          "en": "Key ID",
          "sv": "Nyckel-ID"
        },
        "usernamePlaceholder": {
          "en": "KeyId from SolisCloud API management"
        },
        "passwordLabel": {
          "en": "Key secret",
          "sv": "Nyckelhemlighet"
        },
        "passwordPlaceholder": {
          "en": "KeySecret"
        }
      },
      "navigation": {
        "prev": "intro"
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "SolisCloud connection",
        "sv": "SolisCloud-anslutning"
      },
      "children": [
        {
          "id": "key_id",
          "type": "text",
          "label": {
            "en": "Key ID"
          },
          "value": ""
        },
        {
          "id": "key_secret",
          "type": "password",
          "label": {
            "en": "Key secret"
          },
          "value": ""
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Backup reserve",
        "sv": "Reservkraft"
      },
      "children": [
        {
          "id": "reserve_summer",
          "type": "number",
          "label": {
            "en": "Reserve April–October"
          },
          "value": 25,
          "min": 0,
          "max": 100,
          "step": 1,
          "units": {
            "en": "%"
          },
          "hint": {
            "en": "Kept for power outages in normal operation. Must be above the inverter's power-outage limit (Off-Grid Overdischarge SOC, set to 15 % here); only the part above that limit is usable during an outage.",
            "sv": "Behålls för strömavbrott vid normal drift. Måste vara över växelriktarens gräns vid strömavbrott (Off-Grid Overdischarge SOC, här 15 %); bara delen över gränsen kan användas vid avbrott."
          }
        },
        {
          "id": "reserve_winter",
          "type": "number",
          "label": {
            "en": "Reserve November–March"
          },
          "value": 30,
          "min": 0,
          "max": 100,
          "step": 1,
          "units": {
            "en": "%"
          }
        },
        {
          "id": "outage_target",
          "type": "number",
          "label": {
            "en": "Charge level when preparing for an outage"
          },
          "value": 100,
          "min": 30,
          "max": 100,
          "step": 1,
          "units": {
            "en": "%"
          }
        }
      ]
    },
    {
